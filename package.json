{
    "name": "graphpilot-demo-api",
    "version": "0.1.0",
    "private": false,
    "description": "A small GraphQL catalogue API that demonstrates every GraphPilot edge caching feature.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "dev": "node --watch src/node.ts",
        "start": "node src/node.ts",
        "build": "node scripts/generate-type-defs.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
        "sdl": "node scripts/generate-type-defs.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
        "lint": "biome check .",
        "dev:worker": "wrangler dev"
    },
    "dependencies": {
        "graphql": "17.0.2",
        "graphql-yoga": "5.24.0",
        "jose": "^6.2.12"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@cloudflare/vitest-plugin": "1.1.11",
        "@types/node": "26.6.1",
        "typescript": "7.0.2",
        "vitest": "4.1.11",
        "wrangler": "4.133.0"
    }
}
